// firebase.rules
// Reference copy of the Firebase Storage security rules this app deploys.
//
// The file Firebase actually deploys is source/storage.rules (see source/firebase.json).
// To change the rules, edit that file, or copy this one over it:
//
//   cp docs/config/firebase.rules source/storage.rules
//
// then run `firebase deploy --only storage` from the source/ folder.
//
// Storage is used only for member photos. The app uses Google Sheets as its
// database, not Firestore.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
