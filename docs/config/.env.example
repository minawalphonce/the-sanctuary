# =============================================================================
# .env.example
# Copy this file to source/app/.env (from the repo root) and fill in the values:
#
#   cp docs/config/.env.example source/app/.env
#
# NEVER commit .env to Git (it's gitignored).
# Keep a copy of the filled-in file somewhere safe (password manager or shared drive).
# See docs/setup/NEW_INSTANCE.md, step 3.
# =============================================================================


# --- Required for every build ---
# These are compiled into the app, so set them before `npm run build`.

# From the sheet URL: https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_SHEET_ID/edit
VITE_SHEET_ID=REPLACE_ME

# Your organisation name, shown as the app name
VITE_ORG_NAME=REPLACE_ME


# --- Optional (defaults are used if left out) ---

# Weekday the regular session ("Lesson") recurs on: a name (sunday..saturday)
# or a number (0=Sunday .. 6=Saturday). Default: saturday
VITE_REGULAR_SESSION_WEEKDAY=saturday

# Dashboard fallback list, shown when no members are assigned to the signed-in
# admin: the top X members with the most consecutive missed sessions, looking
# back over the last Y sessions. Defaults: 5 and 8.
VITE_DASHBOARD_TOP_X=5
VITE_DASHBOARD_LAST_Y=8


# --- Only for running locally (`npm run dev`) ---
# A deployed app on Firebase Hosting loads these automatically, so you can leave
# them out if you only deploy. Find them in:
# Firebase Console -> Project settings -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
