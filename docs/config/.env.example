# =============================================================================
# .env.example
# Copy this file to .env in the project root and fill in the values.
#
#   cp docs/config/.env.example .env
#
# NEVER commit .env to Git.
# Store the filled .env securely (password manager or shared secure drive).
# =============================================================================


# --- Firebase ---
# These values are ONLY needed for local development (vite dev).
# When deployed to Firebase Hosting, config is loaded automatically from /__/firebase/init.json.
# Found in: Firebase Console → Project Settings → Your apps → SDK config

VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME

# Optional — only needed if using Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=


# --- Google Sheets ---
# Found in the sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_YOUR_SHEET_ID/edit

VITE_SHEET_ID=REPLACE_ME


# --- Organisation ---
# Displayed in the app header

VITE_ORG_NAME=REPLACE_ME


# --- Attendance ---
# Weekday the regular session ("Lesson") recurs on. Accepts a weekday name
# (sunday..saturday) or a number (0=Sunday .. 6=Saturday). Defaults to
# Saturday if unset.

VITE_REGULAR_SESSION_WEEKDAY=saturday


# --- Dashboard ---
# Fallback list shown on the Home tab when no members are assigned to the
# signed-in admin: the top N members with the most consecutive missed
# sessions, looking back over the last M sessions. Defaults: 5 and 8.

VITE_DASHBOARD_TOP_X=5
VITE_DASHBOARD_LAST_Y=8


# --- FCM (Push Notifications) ---
# Found in: Firebase Console → Cloud Messaging → Web configuration → Web Push certificates
# Optional — leave blank if FCM is not set up yet

VITE_FIREBASE_VAPID_KEY=
